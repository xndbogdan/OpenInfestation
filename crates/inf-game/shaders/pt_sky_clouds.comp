#version 450
// The modern sky's clouds, in three passes over the frame block
// (pt_sky.glsl):
// 0. the view, at a quarter of the display's width and height: each pixel
//    marches the clouds along its direction from a jittered start and
//    takes a sixth of the new result into its history (half where they
//    lie near the eye), found where the last frame saw the clouds' point
//    (clear sky at infinity); where they lie along the ray goes with them
//    (pt_sky.glsl's clouds_before), for the composite to lay them over the
//    world behind;
// 1. the sky cube map the tracer's reflections look up: the gradient with
//    the clouds over it, in every direction;
// 2. the clouds' shadow map: how much sunlight passes the layer above each
//    point of its base plane, around the eye.
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8) in;

#define FRAME_BINDING 0
#include "pt_frame.glsl"
#define SKY_NOISE_BINDING 1
#include "pt_sky.glsl"

layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D view_out;
layout(set = 0, binding = 4) uniform sampler2D view_history;
layout(set = 0, binding = 5, rgba16f) uniform writeonly imageCube cube_out;
layout(set = 0, binding = 6, r16f) uniform writeonly image2D shadow_out;
// Where the view's clouds lie (clouds_toward's `placed`, its distances in
// CLOUD_DISTANCE_UNIT), and its history.
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D away_out;
layout(set = 0, binding = 8) uniform sampler2D away_history;
layout(push_constant) uniform Pass {
    uint which;
    // 1 when the history holds the last frame's clouds at this size.
    uint history;
} pass;

// The direction through texel `xy` (0 to 1 across) of cube face `face`.
vec3 cube_direction(vec2 xy, int face) {
    vec2 uv = xy * 2.0 - 1.0;
    vec3 d;
    if (face == 0) {
        d = vec3(1.0, -uv.y, -uv.x);
    } else if (face == 1) {
        d = vec3(-1.0, -uv.y, uv.x);
    } else if (face == 2) {
        d = vec3(uv.x, 1.0, uv.y);
    } else if (face == 3) {
        d = vec3(uv.x, -1.0, -uv.y);
    } else if (face == 4) {
        d = vec3(uv.x, -uv.y, 1.0);
    } else {
        d = vec3(-uv.x, -uv.y, -1.0);
    }
    return normalize(d);
}

// Where `direction` from the last frame's eye showed in that frame, 0 to 1
// across the view, or below zero where it lay behind the camera.
vec2 previous_place(vec3 direction) {
    float ahead = dot(direction, frame.previous_forward);
    if (ahead <= 1.0e-4) {
        return vec2(-1.0);
    }
    vec2 view = vec2(dot(direction, frame.previous_right), -dot(direction, frame.previous_up))
        / ahead;
    vec2 native = frame.previous_centre + frame.previous_focal * view;
    return (native + 0.5) / frame.native;
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    uint seed = sky_hash(uint(texel.x) * 1973u + uint(texel.y) * 9277u
                         + uint(frame.frame_index) * 26699u);
    float jitter = float(seed & 0xffffu) / 65536.0;
    if (pass.which == 0u) {
        ivec2 size = imageSize(view_out);
        if (any(greaterThanEqual(texel, size))) {
            return;
        }
        vec2 uv = (vec2(texel) + 0.5) / vec2(size);
        vec3 direction = native_direction(uv * frame.native - 0.5);
        vec4 placed;
        vec4 clouds = clouds_toward(direction, 64, jitter, frame.cloud_craft, placed);
        // Clouds farther than the image holds count as clear sky.
        vec4 kept = vec4(min(placed.x / CLOUD_DISTANCE_UNIT, CLOUD_DISTANCE_NONE), placed.yz,
                         min(placed.w / CLOUD_DISTANCE_UNIT, CLOUD_DISTANCE_NONE));
        if (pass.history != 0u) {
            vec3 seen = direction;
            if (kept.w < CLOUD_DISTANCE_NONE) {
                // Within the wrap, as pt_history.glsl's from_previous_eye.
                seen = frame.eye + direction * placed.w - frame.previous_eye;
                seen.xz = mod(seen.xz + 32768.0, 65536.0) - 32768.0;
            }
            vec2 then = previous_place(normalize(seen));
            if (all(greaterThanEqual(then, vec2(0.0))) && all(lessThanEqual(then, vec2(1.0)))) {
                // A sixth of the new march, but half where the light comes
                // from near the eye (a flight through a cloud), whose wisps
                // stream past too quickly for the history; a flash is
                // quicker still: it takes the most while it lasts.
                float fresh = max(mix(0.5, 1.0 / 6.0, smoothstep(1000.0, 3000.0, placed.w)),
                                  mix(1.0 / 6.0, 0.75, lightning_flash().w));
                clouds = mix(textureLod(view_history, then, 0.0), clouds, fresh);
                kept = mix(textureLod(away_history, then, 0.0), kept, fresh);
            }
        }
        imageStore(view_out, texel, clouds);
        imageStore(away_out, texel, kept);
    } else if (pass.which == 1u) {
        int side = imageSize(cube_out).x;
        int face = int(gl_GlobalInvocationID.z);
        if (any(greaterThanEqual(texel, ivec2(side)))) {
            return;
        }
        vec3 direction = cube_direction((vec2(texel) + 0.5) / float(side), face);
        vec4 placed;
        vec4 clouds = clouds_toward(direction, 24, 0.5, 0.0, placed);
        vec3 color = sky_gradient(direction, 0.0) * clouds.a + clouds.rgb;
        imageStore(cube_out, ivec3(texel, face), vec4(color, 1.0));
    } else {
        ivec2 size = imageSize(shadow_out);
        if (any(greaterThanEqual(texel, size))) {
            return;
        }
        // A point of the layer's lowest base plane (less its clouds' rise),
        // and the sunlight that reaches it through the layer.
        vec2 across = ((vec2(texel) + 0.5) / vec2(size) - 0.5) * SKY_SHADOW_SPAN;
        vec3 world = vec3(frame.eye.x + across.x, frame.cloud_base - frame.cloud_rise,
                          frame.eye.z + across.y);
        float light = 1.0;
        if (frame.cloud_cover > 0.0 && frame.sun_direction.y > 0.05) {
            float through = (frame.cloud_top - frame.cloud_base + 2.0 * frame.cloud_rise)
                / frame.sun_direction.y;
            float step = through / 12.0;
            float depth = 0.0;
            for (int i = 0; i < 12; i++) {
                vec3 at = world + frame.sun_direction * ((float(i) + 0.5) * step);
                depth += cloud_density(at, false) * step;
            }
            light = exp(-depth * CLOUD_SIGMA);
        }
        imageStore(shadow_out, texel, vec4(light));
    }
}
