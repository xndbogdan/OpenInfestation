#version 460
// TAA over the world's colour, traced or the raster's, before the HUD (the
// raster's later draws stay sharp). Each frame's jittered colour blends
// into the history, which follows each pixel's motion back to the last
// frame and is held within the colour's own neighbourhood (mean and spread
// in YCoCg), so moving edges and changing light do not ghost.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 1, rgba16f) uniform readonly image2D color_image;
layout(set = 0, binding = 2, rg16f) uniform readonly image2D motion_image;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D history_image;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D history_out;

// 1 when the history holds nothing of the last frame's (TAA just turned
// on, the size changed, or the last frame's view cannot be followed).
layout(push_constant) uniform Pass {
    int fresh;
} pass;

// The new frame's share of the history.
const float CURRENT = 0.1;

ivec2 size;

vec3 to_ycocg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 from_ycocg(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

vec3 history_at(vec2 position) {
    vec2 base = floor(position - 0.5);
    vec2 f = position - 0.5 - base;
    ivec2 b = ivec2(base);
    vec3 texel[4];
    for (int i = 0; i < 4; i++) {
        texel[i] = imageLoad(history_image, clamp(b + ivec2(i & 1, i >> 1), ivec2(0), size - 1)).rgb;
    }
    return mix(mix(texel[0], texel[1], f.x), mix(texel[2], texel[3], f.x), f.y);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    size = imageSize(color_image);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    vec3 current = imageLoad(color_image, pixel).rgb;
    vec3 sum = vec3(0.0);
    vec3 squares = vec3(0.0);
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            vec3 c = to_ycocg(imageLoad(color_image, clamp(pixel + ivec2(dx, dy), ivec2(0), size - 1)).rgb);
            sum += c;
            squares += c * c;
        }
    }
    vec3 mean = sum / 9.0;
    vec3 spread = sqrt(max(squares / 9.0 - mean * mean, vec3(0.0))) * 1.25;

    // Where this pixel's content sat in the last frame.
    vec2 then = vec2(pixel) + 0.5 + imageLoad(motion_image, pixel).xy;
    vec3 result = current;
    if (pass.fresh == 0 && all(greaterThanEqual(then, vec2(0.0)))
        && all(lessThan(then, vec2(size)))) {
        vec3 history = to_ycocg(history_at(then));
        history = clamp(history, mean - spread, mean + spread);
        result = mix(from_ycocg(history), current, CURRENT);
    }
    imageStore(history_out, pixel, vec4(result, 1.0));
}
